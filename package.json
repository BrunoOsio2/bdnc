{
  "name": "projeto-bdnc",
  "version": "1.0.0",
  "description": "Base Node.js + TypeScript + PostgreSQL para o Trabalho Integrador de BDNC (Problema A - comercio eletronico)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:create": "createdb bdnc 2>/dev/null || true",
    "db:schema": "psql -d bdnc -f src/database/schema.sql",
    "db:seed": "psql -d bdnc -f src/database/seed.sql",
    "db:vector": "psql -d bdnc -f src/database/pgvector.sql",
    "db:setup": "npm run db:create && npm run db:schema && npm run db:seed",
    "db:setup:vector": "node scripts/setup-db.js"
  },
  "keywords": [
    "bdnc",
    "ecommerce",
    "express",
    "typescript",
    "postgresql"
  ],
  "license": "ISC",
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
